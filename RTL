
//============================================================
// Project     : Asynchronous FIFO
// Module      : async_fifo_top
// Author      : Ramasubbu Bala Murugan
// Description : Dual-port FIFO memory
// Language    : Verilog-2001
//============================================================

module async_fifo_top
  #(
  parameter DATA_WIDTH = 8,
  parameter DEPTH      = 16,
  parameter ADDR_WIDTH = $clog2(DEPTH)
  ) 
  (
  input wire                   wr_clk,
  input wire                   wr_rst,
  input wire                    wr_en,
  input wire [DATA_WIDTH-1:0] wr_data,
  
  input wire                   rd_clk,
  input wire                   rd_rst,
  input wire                    rd_en,
    
  output wire [DATA_WIDTH-1:0] rd_data,
  output wire                     full,
  output wire                    empty
  );
  
  //--------------------------------------
  // Write pointer output
  // -------------------------------------
  
  wire [ADDR_WIDTH:0] wr_bin;
  wire [ADDR_WIDTH:0] wr_gray;
  wire                wr_fire;
  
  //--------------------------------------
  //Read pointer output
  //--------------------------------------
  
  wire [ADDR_WIDTH:0] rd_bin;
  wire [ADDR_WIDTH:0] rd_gray;
  wire                rd_fire;
  
  //--------------------------------------
  //Synchronized Pointers
  //--------------------------------------
  
  wire [ADDR_WIDTH:0] wr_gray_sync;
  wire [ADDR_WIDTH:0] rd_gray_sync;
  

  //--------------------------------------
  //Memory Instantiation
  //--------------------------------------
  
  async_fifo_mem
  #(
    .DATA_WIDTH(DATA_WIDTH),
    .DEPTH(DEPTH),
    .ADDR_WIDTH(ADDR_WIDTH)
   ) 
  u_mem
   (
     .wr_clk      (wr_clk),
     .wr_en       (wr_fire),
     .wr_bin      (wr_bin),
     .wr_data     (wr_data),
     
     .rd_clk      (rd_clk),
     .rd_en       (rd_fire),
     .rd_bin      (rd_bin),
     .rd_data     (rd_data)
   );
  
  //--------------------------------------
  //Write Pointer Instantiation
  //--------------------------------------
  
  async_fifo_wptr
  #(
    .ADDR_WIDTH   (ADDR_WIDTH)
   ) 
  u_wptr
  (
    .wr_clk       (wr_clk),
    .wr_rst       (wr_rst),
    .wr_en        (wr_en),
    .rd_gray_sync (rd_gray_sync),
    
    .wr_bin       (wr_bin),
    .wr_gray      (wr_gray),
    .full         (full),
    .wr_fire      (wr_fire)
  );
  
  //--------------------------------------
  //Read Pointer Instantiation
  //--------------------------------------
  
  async_fifo_rptr
  #(
    .ADDR_WIDTH       (ADDR_WIDTH)
   )
  u_rptr
   (
     .rd_clk             (rd_clk),
     .rd_rst             (rd_rst),
     .rd_en               (rd_en),
     .wr_gray_sync (wr_gray_sync),
     
     .rd_bin            (rd_bin),
     .rd_gray          (rd_gray),
     .empty              (empty),
     .rd_fire          (rd_fire)
   );
  
  //--------------------------------------
  //Synchronizer Write Instantiation
  //--------------------------------------
  
  sync_ptr
  #(
    .ADDR_WIDTH        (ADDR_WIDTH)
   )
  u_sync_wptr
   (
     .clk                  (rd_clk),
     .rst                  (rd_rst),
     .ptr_gray             (wr_gray),
     
     .ptr_gray_sync   (wr_gray_sync)
   );
  
  //--------------------------------------
  //Synchronizer Read Instantiation
  //--------------------------------------
  sync_ptr
  #( 
    .ADDR_WIDTH        (ADDR_WIDTH)
   )
  u_sync_rptr
  ( 
     .clk                 (wr_clk),
     .rst                 (wr_rst),
     .ptr_gray            (rd_gray),
     
     .ptr_gray_sync  (rd_gray_sync)
   );
  
endmodule

